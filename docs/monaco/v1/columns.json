[
  {
    "columnName": "itemName",
    "width": "300px",
    "template": {
      "tagName": "input",
      "attributes": {
        "type": "text",
        "placeholder": "enter ${columnName}",
        "name": "${columnName}",
        "id": "${columnName}",
        "list": "${columnName}",
        "class": "form-control"
      }
    }
  },
  {
    "columnName": "baseUnit",
    "width": "200px",
    "template": {
      "tagName": "button",
      "textContent": "${columnName}",
      "attributes": {
        "class": "btn btn-primary btn-sm"
      }
    }
  },
  {
    "columnName": "batches",
    "width": "100px",
    "template": {
      "tagName": "tr",
      "attributes": {
        "class": "align-middle"
      },
      "children": []
    }
  }
]

